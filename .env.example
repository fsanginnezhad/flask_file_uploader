# این فایل رو کپی کن به .env و مقادیر رو پر کن
# cp .env.example .env

SECRET_KEY=change-this-to-a-random-secret-string
JWT_SECRET_KEY=change-this-to-another-random-secret-string
# DATABASE_URL رو خالی بذار تا از مسیر مطلق پیش‌فرض (کنار پروژه) استفاده بشه.
# اگه مقدار نسبی مثل sqlite:///app.db بدی، فلاسک اون رو داخل پوشه‌ی instance/ می‌سازه
# که می‌تونه گیج‌کننده باشه — پس یا خالی بذار، یا یک مسیر مطلق کامل بده.
# DATABASE_URL=sqlite:///app.db
UPLOAD_FOLDER=uploads

# مقادیر پیش‌فرض سراسری (قابل تغییر بعداً از طریق API ادمین)
DEFAULT_MAX_FILE_SIZE_MB=50
DEFAULT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,docx,xlsx,zip
